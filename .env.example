# ============================================================================
# Teek 教学助手 — 环境配置
# ============================================================================
# 复制此文件为 .env 并修改其中的值，.env 不会被提交到 Git
#
# 配置文件层级（优先级从低到高）：
#   .env.example  →  .env  →  系统环境变量
# ============================================================================

# ========== Django ==========

# 密钥（生产环境必须改为强随机字符串！）
# 生成方式: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-teek-teaching-assistant-2024-secret-key-change-in-prod

# Agent API Key 的 Fernet 加密密钥（可选）
# 格式: 32 字节 urlsafe-base64，生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 不配置则回退到由 DJANGO_SECRET_KEY 派生（轮换 SECRET_KEY 会导致旧密文解不开）
# 配置后请填入真实密钥；此处仅占位符，且配置错误的值会导致启动报错，故保持注释状态
# API_KEY_ENCRYPTION_KEY=your-fernet-key-32-bytes-urlsafe-base64

# 调试模式（开发 True，生产 False）
DJANGO_DEBUG=True

# 允许的主机名（逗号分隔）
DJANGO_ALLOWED_HOSTS=*

# ========== MySQL 数据库 ==========

DB_NAME=teek_teaching_assistant
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ========== CORS（跨域白名单）==========

# 允许的前端地址（逗号分隔），开发默认 localhost:8099
CORS_ALLOWED_ORIGINS=http://localhost:8099,http://127.0.0.1:8099

# ========== 前端 Vite 代理 ==========

# Vite 开发服务器将 /api 请求代理到此地址
VITE_PROXY_TARGET=http://localhost:9000

# ========== ChromaDB 向量数据库 ==========

# 向量数据库持久化目录（默认 backend/chroma_data）
# CHROMADB_PERSIST_DIR=backend/chroma_data

# ========== 前端 Vite ==========

VITE_API_URL=/api
VITE_PUBLIC_PATH=/
VITE_ROUTER_MODE=history, /
VITE_LOAD_ALL_EP_STYLE=true
VITE_LOAD_ALL_EP_COMPONENTS=true
VITE_WEBSOCKET_URL=
